generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id           String       @id @db.Uuid
  email        String       @unique @db.VarChar()
  password     String       @db.VarChar()
  firstName    String       @db.VarChar() @map("first_name")
  lastName     String       @db.VarChar() @map("last_name")
  phoneNumber  String       @db.VarChar() @map(" phone_number")
  status       String       @default("ACTIVE") @db.VarChar()
  roles       UserRole[]
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @updatedAt
  @@map("user")
}

model Role {
  id          String      @id @db.Uuid
  name        String      @unique @db.VarChar()
  permissions RolePermission[]
  users       UserRole[]
  description String?     @db.VarChar()
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  @@map("role")
}

model Permission {
  id          String   @id @db.Uuid
  name        String   @unique @db.VarChar()
  roles       RolePermission[]
  description String?  @db.VarChar()
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  @@map("permission")
}

model UserRole {
  userId String   @db.VarChar() @map("user_id")
  roleId String   @db.VarChar() @map("role_id")

  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String  @db.VarChar() @map("role_id")
  permissionId String  @db.VarChar() @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}
